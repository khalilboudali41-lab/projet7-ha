# =============================================================================
# Projet 7 – Root CA (hors ligne)
# Signe uniquement la CA intermédiaire. Sa clé privée est ensuite archivée
# chiffrée hors de la VM (scripts/pki.sh offline).
# =============================================================================
[ ca ]
default_ca = CA_root

[ CA_root ]
dir               = $ENV::PKI_DIR/root-ca
certs             = $dir/certs
new_certs_dir     = $dir/newcerts
database          = $dir/db/index.txt
serial            = $dir/db/serial
crlnumber         = $dir/db/crlnumber
private_key       = $dir/private/root-ca.key
certificate       = $dir/certs/root-ca.crt
crl               = $dir/crl/root-ca.crl
default_md        = sha384
default_days      = 1825
default_crl_days  = 365
preserve          = no
unique_subject    = no
copy_extensions   = none
policy            = policy_ca

[ policy_ca ]
organizationName       = match
organizationalUnitName = optional
commonName             = supplied

[ req ]
default_md          = sha384
distinguished_name  = req_dn
string_mask         = utf8only
prompt              = no

[ req_dn ]
O  = Projet7 HA
OU = PKI interne
CN = Projet7 Root CA

# Auto-signature de la racine
[ v3_root_ca ]
basicConstraints       = critical, CA:true
keyUsage               = critical, keyCertSign, cRLSign
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid:always

# Signature de la CA intermédiaire : ne peut signer que des certificats finaux,
# et uniquement pour projet7.local et ses sous-domaines (limite l'impact d'une
# compromission de sa clé, qui reste en ligne)
[ v3_intermediate_ca ]
basicConstraints       = critical, CA:true, pathlen:0
nameConstraints        = critical, permitted;DNS:projet7.local
keyUsage               = critical, keyCertSign, cRLSign
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid:always
