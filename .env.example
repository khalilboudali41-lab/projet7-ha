# =============================================================================
# Projet 7 – variables d'environnement (copier en .env : scripts/deploy.sh init-env)
# .env est NON versionné (chmod 600). Les mots de passe vides sont générés
# aléatoirement par init-env, puis exportés en fichiers secrets/ (montés dans
# /run/secrets des conteneurs, jamais en variables d'environnement).
# =============================================================================

# --- Tier données (MariaDB Galera) ---
DB_ROOT_PASSWORD=
DB_SST_PASSWORD=
DB_MONITOR_PASSWORD=
DB_APP_PASSWORD=
DB_BACKUP_PASSWORD=

# --- Tier LB (HAProxy / keepalived) ---
HAPROXY_STATS_USER=admin
HAPROXY_STATS_PASSWORD=
# VRRP auth PASS : seuls les 8 premiers caractères sont utilisés (limite VRRPv2)
VRRP_PASSWORD=

# --- Paramètres (non secrets) ---
TZ=Europe/Paris
BACKUP_INTERVAL_SECONDS=21600
BACKUP_RETENTION_DAYS=7
