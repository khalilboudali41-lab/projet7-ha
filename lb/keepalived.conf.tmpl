# =============================================================================
# keepalived – @LB_NAME@ (généré au démarrage par lb-entrypoint.sh)
# VRRP en unicast entre lb1 et lb2 (pas de multicast sur le LAN VMnet8).
# Les deux nœuds démarrent en BACKUP ; le plus prioritaire devient MASTER et,
# après une panne, ne reprend la VIP qu'au bout de 10 s de stabilité.
# =============================================================================
global_defs {
    router_id @LB_NAME@
    enable_script_security
    script_user haproxy
    vrrp_garp_master_delay 1
    vrrp_garp_master_repeat 3
}

# HAProxy doit répondre réellement (pas seulement exister) : page de supervision locale
vrrp_script chk_haproxy {
    script "/usr/bin/wget -q -T 1 -O /dev/null http://127.0.0.1:8405/healthz"
    interval 1
    timeout 2
    fall 2
    rise 2
}

# Multi-VM : chaîne complète de CETTE VM (web → app → dbproxy → Galera). Échec →
# priorité −60 (lb1 150 → 90 < lb2 100 : la VIP part sur l'autre VM ; lb2 100 → 40 :
# reste BACKUP). Poids plutôt que FAULT : si la base tombe PARTOUT, les deux LB
# baissent d'autant et la VIP reste en place (page 503) au lieu de disparaître.
# Timeout : /healthz/db = 2 essais × (2 s + 0,3 s) au pire. Suivie seulement en
# multi-VM (@TRACK_DB@ remplacé par l'entrypoint).
vrrp_script chk_db_path {
    script "/usr/bin/wget -q -T 5 -O /dev/null http://172.30.10.11:8080/healthz/db"
    interval 3
    timeout 6
    fall 2
    rise 3
    weight -60
}

vrrp_instance VI_PROJET7 {
    state BACKUP
    interface lan0
    virtual_router_id 70
    priority @PRIORITY@
    advert_int 1
    preempt_delay 10
    unicast_src_ip @LB_IP@
    unicast_peer {
        @PEER_IP@
    }
    authentication {
        auth_type PASS
        auth_pass @VRRP_PASS@
    }
    virtual_ipaddress {
        @VIP@/24 dev lan0 label lan0:vip
    }
    track_script {
        chk_haproxy
        @TRACK_DB@
    }
    # ipvlan : réessaie la pose de la VIP pendant que l'ancien MASTER la libère
    notify_master "/usr/local/bin/vip-ensure.sh @VIP@ lan0" root
}
